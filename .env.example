# Copy this file to .env and remove the # in front of a line to change a setting.
# A variable set in the real environment wins over .env.

# Port of the web app. The address is always 127.0.0.1.
# SIT_PORT=8000

# Folder for the database and model files. Relative to the repository root unless absolute.
# SIT_DATA_DIR=data

# Provider preselected on first use: ollama or anthropic
# SIT_DEFAULT_PROVIDER=ollama

# Where Ollama listens
# SIT_OLLAMA_URL=http://127.0.0.1:11434

# Local model preselected in the start form
# SIT_OLLAMA_MODEL=llama3.1:8b

# Context window requested from Ollama, in tokens
# SIT_OLLAMA_NUM_CTX=8192

# Claude model preselected in the start form
# SIT_ANTHROPIC_MODEL=claude-opus-5-5

# Thinking effort for Claude: low, medium, high, xhigh or max
# SIT_ANTHROPIC_EFFORT=medium

# Read by the Anthropic SDK. Only for cloud mode.
# ANTHROPIC_API_KEY=

# Time limit for one model call, in seconds
# SIT_LLM_TIMEOUT_S=180

# 1 replaces the model and the embedder with fakes. For tests and interface work.
# SIT_DEV_FAKE=0

# Speech model, M3
# SIT_WHISPER_MODEL=base.en

# Speech device, M3
# SIT_WHISPER_DEVICE=cpu

# Speech number format, M3
# SIT_WHISPER_COMPUTE=int8

# Optional hint text for the recogniser, M3
# SIT_WHISPER_PROMPT=
